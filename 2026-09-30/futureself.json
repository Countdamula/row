    "statements": [
      {
        "id": "idn_mt4vcmx207dcjo",
        "order": 0,
        "text": "I write consistently."
      },
      {
        "id": "idn_mt4vcmx2hert32",
        "order": 1,
        "text": "I finish what I start."
      },
      {
        "id": "idn_mt4vcmx2kzs092",
        "order": 2,
        "text": "I protect my time."
      },
      {
        "id": "idn_mt4vcmx2skrthl",
        "order": 3,
        "text": "I take care of my body."
      },
      {
        "id": "idn_mt4vcmx2otqygf",
        "order": 4,
        "text": "I create instead of endlessly consuming."
      },
      {
        "id": "idn_mt4vcmx2djklkb",
        "order": 5,
        "text": "I make decisions quickly."
      },
      {
        "id": "idn_mt4vcmx2zru4dn",
        "order": 6,
        "text": "I trust myself."
      },
      {
        "id": "idn_mt4vcmx2bkv4wq",
        "order": 7,
        "text": "I build systems rather than relying on motivation."
      },
      {
        "id": "idn_mt4vcmx25u69al",
        "order": 8,
        "text": "I am disciplined even when I do not feel motivated."
      },
      {
        "id": "idn_mt4vcmx2riwdkm",
        "order": 9,
        "text": "I am a professional novelist who treats writing like his life’s work."
      }
    ],
